NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ironvault?retryWrites=true&w=majority
MONGODB_URI=
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Used by `npm run seed:admin` to create the first admin account
ADMIN_NAME=System Administrator
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
